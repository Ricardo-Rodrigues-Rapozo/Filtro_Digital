module sinal_memoria #(
							 parameter DATA_WIDTH = 16, 
							 parameter ADDR_WIDTH = 8)
							 (
							 input clk, rst_geral, sampling,
							 output signal
							 );
							
// Memória
reg [DATA_WIDTH-1:0] rom[2**ADDR_WIDTH-1:0];

initial
begin
	$readmemb("C:\Users\Ricardo\Documents\Dissertacao\Aurora\dados_simulacao\sinal_teste.txt", rom);
end

always @ (posedge clk)
begin
	q <= rom[addr];
end

endmodule 