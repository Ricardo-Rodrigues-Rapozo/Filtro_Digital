//} */


void main()
{   

    comp temp; // variavel da ifft
    int frequencia_from_int = 0;
    int sample_count = 0;
    int output_count = 0;
    float output_buffer_real[256];
    float output_buffer_imag[256];

    float buffer[256];
    float E[256][8];

    int M;
    int idx;
    int k;
    int test_idx;
    int reset_idx;
    int oo;
    int out_idx;
    int mm;  
    int ii; 
    float x;
    float acc;
    float norm_factor;
    float vector_count;
    int buffer_head;
    int fft_limit;
    
    float Ehh[256][8] "Ehh.txt";
    
    M = 256;
    fft_limit=M;
    sample_count = (M - 1);
    output_count = 0;
    vector_count = 0;
    buffer_head = 0;
    //return;
	
	// ===== LOOP PRINCIPAL =====
    return;
    #PRACA
    //while(1)
    //{
        fout(2,0);
        fout(1,1);
        

         // -------------------- BUFFER CIRCULAR ------------------------------- // 
        buffer_head = buffer_head -1;        
        if(buffer_head < 0)
        {
            buffer_head = M - 1;
        }
        buffer[buffer_head] = in(0) / 1000000.0;
        fout(2,1);

        frequencia_from_int = in(1);

        


         // ------------------- DECIMAÇÃO --------------------------------- //        
        if(sample_count == (M - 1))
        {
            
            sample_count=0;
            mm = 0;
            ii = buffer_head;
            // ------------------ FILTRO POLIFASICO ----------------------------- // 
            while(mm<M)
            {  
                E[mm][7] = E[mm][6];

                E[mm][6] = E[mm][5];

                E[mm][5] = E[mm][4];

                E[mm][4] = E[mm][3];

                E[mm][3] = E[mm][2];
                //fout(12,(1000000*E[3][0]));
                E[mm][2] = E[mm][1];
                //fout(11,(1000000*E[2][0]));
                E[mm][1] = E[mm][0];
                //fout(10,(1000000*E[1][0]));
                E[mm][0] = buffer[ii];
                //fout(9,(1000000*E[0][0]));

                E0[mm] =  Ehh[mm][0] * E[mm][0] + 
                        Ehh[mm][1] * E[mm][1] + 
                        Ehh[mm][2] * E[mm][2] + 
                        Ehh[mm][3] * E[mm][3] + 
                        Ehh[mm][4] * E[mm][4] + 
                        Ehh[mm][5] * E[mm][5] + 
                        Ehh[mm][6] * E[mm][6] + 
                        Ehh[mm][7] * E[mm][7];
                mm = mm + 1;
                ii = ii + 1;
                if(ii >=M)
                {
                    ii = 0;
                }
                fout(2,2);  
            }
            fout(2,3);
            // ----------------------------------- CALCULO DA IFFT -----------------------// 
            int mmax = 1;
            while (mmax < M)
            {
                int istep = mmax * 2;
                int m     = 0;
                int ind   = 0;
                int sind  = 0;
                while (m < mmax)
                {
                    int q = m;
                    while (q < M)
                    {
                        int j   = q+mmax;
                        temp    = wpv[sind]*E0[j);
                        E0[j) =   E0[q) - temp;
                        E0[q) =   E0[q) + temp;
                        q       = q+istep;
                        ind++;
                    }
                    sind = ind;
                    m++;
                }
                mmax = istep;
            }
            fout(2,4);

            out(0,frequencia_from_int);
            
            //iterar o valor que esta dentro do E0 ate o 50 
            while(vector_count <= 50)
            {
                fout(0,real (1000000*E0[vector_count)));
                fout(0,imag (1000000*E0[vector_count)));
                vector_count = vector_count + 1; 
            }
            vector_count = 0;
            fout(2,5);
        }
        else
        {
            sample_count = sample_count + 1;
        }
        fout(1,0);
    //}
}