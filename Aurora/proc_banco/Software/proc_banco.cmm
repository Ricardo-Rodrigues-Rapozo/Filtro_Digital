#PRNAME proc_banco
#NUBITS 32
#NDSTAC 5
#SDEPTH 5
#NUIOIN 2
#NUIOOU 4 // numero de saídas do sapho para analisar
#NBMANT 23
#NBEXPO 8
#FFTSIZ 8
#NUGAIN 128

comp E0[256];
comp wpv[128] "wpv.txt"; 

/*
